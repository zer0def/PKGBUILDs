pkgname = linux-xe303c12
	pkgdesc = The Linux Kernel, flash image, modules and headers for samsung/google snow XE303C12 chromebook - ARMv7 XE303C12-platform
	install = linux-xe303c12.install
	depends = coreutils
	depends = kmod
	depends = uboot-tools
	depends = vboot-utils
	optdepends = linux-xe303c12-firmware: contains the necessary firmwares for the xe303c12 chromebook, takes up 5M or something
	optdepends = linux-firmware: contains all available firmwares, takes up 500M or something
	optdepends = crda: to set the correct wireless channels of your country
	optdepends = mkinitcpio>=0.7: not needed for this kernel actually
	provides = linux=6.12.43
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = linux-armv7
	replaces = linux-armv7-chromebook
	replaces = linux-armv7-rc-chromebook
	replaces = linux-armv7-rc
	replaces = linux-armv7-rc-chromebook
