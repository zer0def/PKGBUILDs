)
b2sums_x86_64=(
  '5c0dcdb49d121f8d30930303c1f5fb25acd89a6ede47bba0b0862660e345ecd937646ec06d4b2f13b90108a579251d9f2a7cafdbbc6ec290226332a5e05453cb'
