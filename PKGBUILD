fi
sha256sums_x86_64=(
  'ab68f972f30bf7e37d47a38ad0ddb68a9d6b7772d766999481dd3b8759415c48'
  'cfde5cfdb595aee0f85c94dcd180a159f4da08408ca770112cd4ef1001de8281'
)
sha512sums_x86_64=(
  'dd7ddfc56e9da78ebf7afd6efe3ede6b1bb1fdad52057b72b600f7776cf91ebe412a7e0e7b589df50e0f91adbda2e0fc8e62e96444308edd5c48fcd5d2bc63cf'
