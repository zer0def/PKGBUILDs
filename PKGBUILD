fi
sha256sums_x86_64=(
  'ca7a001609bd5b992be12dd134e5ff330d9d24d8cd3bbe95b1de2b8af5a4057a'
  'f1e34502cbbd6a24bf19374d41ae0d90c9f7c5db8a41685b9b09197710723eb6'
)
sha512sums_x86_64=(
  'ebfb36240f05e6f17c65cc08a0a709536150f6f67bb776de4e5c0896562e57b492eb4d6394b3f3df43d3e9a78c1d8578d277aff9814c25c5a2abf5c1bb066374'
