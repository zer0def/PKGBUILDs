sha256sums_x86_64=(
  'bee3739b2bdc182c68e4ebba4f1209f1ba4a96c258eeb4bbdfb825981a163419'
  '2c6be6a1c3547c574fbf1ec71da2569f948b0e94775f4ced676b16ef0c6a6ede'
)
sha512sums_x86_64=(
  '8906af45794fd78c6dc610b6b1f5c7ccb7e495c8d45ecb6789121fe16c56629715597821063ac6359db23184d97a1138c92f8ddf4871b9ef0b7f137a6c1eb969'
